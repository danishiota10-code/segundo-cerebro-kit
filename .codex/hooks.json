{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/session-start.py\" --codex",
            "statusMessage": "Carregando o seu segundo cérebro"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/session-capture.py\""
          }
        ]
      }
    ]
  }
}
